# Rendering (Remotion Lambda)
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Optional OpenAI TTS key / legacy CodeCraft fallback key
OPENAI_API_KEY=

# Code generation uses src/lib/model-router.ts and MODEL_CHAIN.
# Default chain: ollama:qwen2.5-coder:1.5b,openrouter:openrouter/free,ollama:hf.co/bartowski/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M
MODEL_CHAIN=
# Ollama must be running with the requested model installed; no OpenAI key needed.
# Default when blank: http://localhost:11434/v1 (on the application server)
# In a hosted environment, use an Ollama URL reachable from the application server.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Legacy provider abstraction (not used by /api/generate's model router).
AI_PROVIDER=

# Phase 2 voice providers. Leave credentials blank until you configure a provider.
OPENAI_BASE_URL=
OPENAI_TTS_MODEL=

ELEVENLABS_API_KEY=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=

# Set GOOGLE_APPLICATION_CREDENTIALS to a local service-account file path, or use ADC.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# Local managed audio cache and project voice-pin store.
VOICE_CACHE_DIR=
VOICE_CACHE_ENABLED=true
VOICE_CACHE_TTL_HOURS=168
VOICE_CACHE_MAX_BYTES=1073741824
VOICE_REQUEST_TIMEOUT_MS=12000
VOICE_MAX_RETRIES=1
VOICE_MAX_FALLBACKS=1
VOICE_INVENTORY_TTL_MS=30000
VOICE_PROVIDER_ORDER=azure-speech,elevenlabs,google-cloud,openai

# Render-and-review loop (POST /api/agent/qa). Every default below is inert: with nothing set the
# loop can still render, but every paid call is refused, so the result is needs_review and never an
# approval. See docs/visual-qa-loop.md.
AGENT_MAX_ITERATIONS=2
AGENT_FRAME_COUNT=4
AGENT_FRAME_WIDTH=512
AGENT_TASK_BUDGET_USD=0.03
AGENT_DAILY_BUDGET_USD=0.25
AGENT_JOB_TTL_MS=1800000
AGENT_KEEP_FRAMES=0

# Visual critique (paid, opt-in). Leave AGENT_VISION_ENABLED unset until a vision model is chosen.
AGENT_VISION_ENABLED=0
AGENT_VISION_PROVIDER=
AGENT_VISION_MODEL=
AGENT_VISION_API_KEY=
AGENT_VISION_BASE_URL=
# Set to 1 ONLY after confirming in the model's official documentation that it accepts images.
AGENT_VISION_IMAGE_SUPPORT_VERIFIED=
AGENT_VISION_JSON_MODE=0
AGENT_CRITIQUE_MAX_OUTPUT_TOKENS=600

# AI repair (paid, opt-in) through the existing model-router chain.
AGENT_REPAIR_ENABLED=0
AGENT_REPAIR_MODEL=
AGENT_REPAIR_MAX_OUTPUT_TOKENS=16000

# Verified pricing. The per-million-token prices, source URL, and ISO verification date are all
# required before a paid call is attempted; a missing price fails closed.
AGENT_PRICE_INPUT_PER_MTOK=
AGENT_PRICE_OUTPUT_PER_MTOK=
AGENT_PRICE_SOURCE_URL=
AGENT_PRICE_VERIFIED_ON=
AGENT_PRICE_NOTES=

# Cloud render backend for the loop (optional).
REMOTION_REGION=
REMOTION_SERVE_URL=
REMOTION_FUNCTION_NAME=
