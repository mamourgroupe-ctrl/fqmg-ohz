{
  "name": "fqmg-ohz-next",
  "version": "0.1.0",
  "private": true,
  "description": "An isolated Phase 2 voice-enabled foundation for the FQMG-OHZ NEXT creative video platform.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "studio": "remotion studio src/remotion/entry.tsx",
    "bundle:remotion": "remotion bundle src/remotion/entry.tsx",
    "render:preview": "remotion render src/remotion/entry.tsx FQMG-OHZ-NEXT-Preview renders/phase-one-preview.mp4",
    "voice:live-check": "tsx scripts/voice-live-check.ts"
  },
  "dependencies": {
    "@remotion/renderer": "4.0.534",
    "google-auth-library": "11.2.0",
    "next": "16.4.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@remotion/cli": "4.0.534",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
